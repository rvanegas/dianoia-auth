# Settings for technosophia's shared scripts (`ts`). The host is the
# ~/.ssh/config alias for the commons box (~/src/rvanegas-site/PROJECTS.md).
HOST=commons
URL=https://auth.rvanegas.co
HEALTH_LOCAL=http://127.0.0.1:8002/healthz
DEPLOY_DEST=auth
DEPLOY_STAMP=auth/deployed.json
DEPLOY_LOG=.local/state/auth-deploys.log
